# Shiksha Gram Backend Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your credentials

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# JWT Secret
JWT_SECRET=your-random-64-character-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
